              "value": "=Bearer {{ $('Login API').first().json.accessToken }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "5f90521e-8c34-4304-bbcc-d26153b2dff5",
      "name": "Consultar próximas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        208
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "errorMessage": "citas-api no disponible tras reintentos; no se enviaron recordatorios"
      },
      "id": "8400e7ef-5ef1-4668-a77a-02af1bbf6bd8",
      "name": "API no disponible",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        672,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const sent = new Set($('Leer enviados').all().map(i => i.json.dedupeKey).filter(Boolean));\nconst now = Date.now();\nconst windowMs = $('Config').first().json.windowHours * 3600000;\nconst out = [];\nfor (const item of $('Consultar próximas').all()) {\n  const j = item.json;\n  if (j.status !== 'APPROVED') continue;\n  const start = Date.parse(j.scheduledStartAt + '-05:00');\n  if (!(start >= now && start <= now + windowMs)) continue;\n  const key = j.id + '|' + j.scheduledStartAt;\n  if (sent.has(key)) continue;\n  out.push({ json: { ...j, dedupeKey: key } });\n}\nreturn out;"
      },
      "id": "61e77d63-abe4-40fb-9ee2-912a734f9f64",
      "name": "Filtrar y deduplicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        208
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "mail-to",
              "name": "to",
              "type": "string",
              "value": "={{ $('Config').first().json.labRecipient }}"
            },
            {
              "id": "mail-subject",
              "name": "subject",
              "type": "string",
              "value": "=Recordatorio: cita #{{ $json.id }} el {{ DateTime.fromISO($json.scheduledStartAt, { zone: 'America/Bogota' }).toFormat('dd/MM/yyyy HH:mm') }}"
            },
            {
              "id": "mail-body",
              "name": "message",
              "type": "string",
              "value": "=Te recordamos tu cita aprobada.\n\nEspecialidad: {{ $json.specialty }}\nProfesional: {{ $json.professional }}\nSede: {{ $json.location }}\nFecha y hora (Bogotá): {{ DateTime.fromISO($json.scheduledStartAt, { zone: 'America/Bogota' }).toFormat('dd/MM/yyyy HH:mm') }} - {{ DateTime.fromISO($json.scheduledEndAt, { zone: 'America/Bogota' }).toFormat('HH:mm') }}\n\nMensaje automático de laboratorio con datos sintéticos."
            },
            {
              "id": "mail-key",
              "name": "dedupeKey",
              "type": "string",
              "value": "={{ $json.dedupeKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7c8a49b2-d1c5-4777-ba98-cc05ea02d6b1",
