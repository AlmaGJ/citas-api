      "parameters": {
        "jsCode": "const enviados = $input.all().length;\nconst fallidos = $('Gmail recordatorio').all().filter(i => i.json.error).length;\nreturn [{ json: { workflow: 'WF-001', enviados, fallidos, ejecutadoEn: new Date().toISOString() } }];"
      },
