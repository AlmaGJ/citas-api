        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/v1/admin/appointments/upcoming",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ DateTime.now().setZone('America/Bogota').toISODate() }}"
            },
            {
              "name": "to",
              "value": "={{ DateTime.now().setZone('America/Bogota').plus({ hours: $('Config').first().json.windowHours }).toISODate() }}"
            }
          ]
        },
