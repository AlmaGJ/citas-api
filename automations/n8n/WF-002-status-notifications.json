    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst allowed = { ADMIN: ['APPROVED', 'REJECTED'], USER: ['CANCELLED'] };\nconst types = ['AppointmentStatusChanged', 'AppointmentRescheduleDecided'];\nlet error = null;\nif (b.schemaVersion !== '1') error = 'schemaVersion';\nelse if (!types.includes(b.eventType)) error = 'eventType';\nelse if (typeof b.eventId !== 'string' || !UUID.test(b.eventId)) error = 'eventId';\nelse if (!Number.isInteger(b.appointmentId) || b.appointmentId <= 0) error = 'appointmentId';\nelse if (b.eventType === 'AppointmentRescheduleDecided' && (!Number.isInteger(b.rescheduleRequestId) || b.rescheduleRequestId <= 0)) error = 'rescheduleRequestId';\nelse if (b.eventType === 'AppointmentRescheduleDecided' && b.source !== 'ADMIN') error = 'source';\nelse if (!allowed[b.source] || !allowed[b.source].includes(b.status)) error = 'status/source';\nelse if (Number.isNaN(Date.parse(b.occurredAt))) error = 'occurredAt';\nreturn [{ json: { valid: !error, error, eventType: b.eventType ?? null, eventId: b.eventId ?? null, appointmentId: b.appointmentId ?? null, rescheduleRequestId: b.rescheduleRequestId ?? null, status: b.status ?? null, source: b.source ?? null, occurredAt: b.occurredAt ?? null } }];"
      },
