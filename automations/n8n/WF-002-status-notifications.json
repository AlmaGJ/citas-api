    {
      "parameters": {
        "jsCode": "const v = $input.first().json;\nconst id = v.appointmentId;\nconst when = new Date(v.occurredAt).toLocaleString('es-CO', { timeZone: 'America/Bogota' });\nlet notificationType, subject, body;\nif (v.eventType === 'AppointmentRescheduleDecided' && v.status === 'APPROVED') { notificationType = 'RESCHEDULE_APPROVED'; subject = `Reprogramación de la cita #${id} aprobada`; body = `La solicitud de reprogramación de la cita #${id} fue aprobada. La cita quedó con el nuevo horario.`; }\nelse if (v.eventType === 'AppointmentRescheduleDecided') { notificationType = 'RESCHEDULE_REJECTED'; subject = `Solicitud de reprogramación de la cita #${id} rechazada`; body = `La solicitud de reprogramación de la cita #${id} fue rechazada. La cita conserva su horario original.`; }\nelse if (v.status === 'CANCELLED') { notificationType = 'CANCELLATION'; subject = `Cita #${id} cancelada`; body = `La cita #${id} fue cancelada por el paciente.`; }\nelse if (v.status === 'REJECTED') { notificationType = 'SPECIALIZED_REJECTED'; subject = `Solicitud de cita #${id} rechazada`; body = `La solicitud de cita #${id} fue rechazada por el equipo administrativo.`; }\nelse { notificationType = 'SPECIALIZED_APPROVED'; subject = `Cita #${id} aprobada`; body = `La solicitud de cita #${id} fue aprobada.`; }\nconst message = `${body}\\n\\nFecha del evento (Bogotá): ${when}\\n\\nMensaje automático de laboratorio con datos sintéticos.`;\nreturn [{ json: { ...v, notificationType, to: $('Config').first().json.labRecipient, subject, message } }];"
      },
      "id": "64fe9234-7b6a-4482-a4f8-7684c692bfbb",
