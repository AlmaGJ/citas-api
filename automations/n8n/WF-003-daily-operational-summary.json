      "id": "44497694-e0a9-4e53-806f-df879fc717ee",
      "name": "Bandeja ADMIN",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        208
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst fecha = cfg.fecha;\nconst citasItems = $('Citas aprobadas del día').all().map(i => i.json);\nconst bandejaItems = $('Bandeja ADMIN').all().map(i => i.json);\nconst incidencias = [];\nfor (const [name, items] of [['Login API', $('Login API').all().map(i => i.json)], ['Citas aprobadas del día', citasItems], ['Bandeja ADMIN', bandejaItems]]) {\n  const err = items.find(j => j.error);\n  if (err) incidencias.push(`${name}: ${String(err.error.message || 'error').slice(0, 160)}`);\n}\nconst citas = citasItems.filter(c => c.id && c.status === 'APPROVED' && String(c.scheduledStartAt).startsWith(fecha));\nconst porSede = {};\nconst porEsp = {};\nfor (const c of citas) { porSede[c.location] = (porSede[c.location] || 0) + 1; porEsp[c.specialty] = (porEsp[c.specialty] || 0) + 1; }\nconst pendCitas = bandejaItems.filter(r => r.type === 'APPOINTMENT' && r.status === 'REQUESTED').length;\nconst pendRe = bandejaItems.filter(r => r.type === 'RESCHEDULE' && r.status === 'PENDING').length;\nconst rows = obj => Object.entries(obj).map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('') || '<tr><td colspan=\"2\">Sin citas aprobadas</td></tr>';\nconst inc = incidencias.length ? '<ul>' + incidencias.map(x => `<li>${x}</li>`).join('') + '</ul>' : '<p>Ninguna</p>';\nconst html = `<h2>Resumen operativo FCV Citas — ${fecha}</h2>\n<h3>Citas aprobadas por sede (total ${citas.length})</h3><table border=\"1\" cellpadding=\"4\">${rows(porSede)}</table>\n<h3>Distribución por especialidad</h3><table border=\"1\" cellpadding=\"4\">${rows(porEsp)}</table>\n<h3>Pendientes de decisión</h3><p>Solicitudes especializadas (REQUESTED): ${pendCitas}<br>Reprogramaciones (PENDING): ${pendRe}</p>\n<h3>No disponible por contrato</h3><p>COMPLETED, NO_SHOW y CANCELLED del día: la API no expone un agregado diario por estado.</p>\n<h3>Incidencias</h3>${inc}\n<p><em>Mensaje automático de laboratorio con datos sintéticos.</em></p>`;\nconst subject = `Resumen operativo FCV Citas — ${fecha}${incidencias.length ? ' (con incidencias)' : ''}`;\nreturn [{ json: { to: cfg.labRecipient, subject, message: html, aprobadas: citas.length, pendientesCitas: pendCitas, pendientesReprogramacion: pendRe, incidencias: incidencias.length } }];"
      },
      "id": "a94ec55f-82df-44d6-9c2a-f270d0c0b73a",
      "name": "Agregar",
